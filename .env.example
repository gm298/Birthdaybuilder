# Copy to .env.local and fill in. Never commit .env.local.
# Dashboard: https://supabase.com/dashboard/project/wvfwnnujxvaukwrtydac/settings/api

# Project
SUPABASE_PROJECT_REF=wvfwnnujxvaukwrtydac
SUPABASE_URL=https://wvfwnnujxvaukwrtydac.supabase.co

# Settings → API → Project API keys
# anon / public (safe for the website, still keep it here)
SUPABASE_ANON_KEY=

# service_role (secret — Edge Function + CLI only, never in HTML/JS)
SUPABASE_SERVICE_ROLE_KEY=

# Account → Access Tokens (for `npx supabase` deploy)
SUPABASE_ACCESS_TOKEN=

# Database password from project creation (optional, for db push)
SUPABASE_DB_PASSWORD=

# Optional extra salt for submit rate limiting
RATE_LIMIT_SALT=

# Shared Tiny Bookings Google Calendar (see supabase/GOOGLE_CALENDAR.md)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SUBSCRIBE_URL=
CALENDAR_SYNC_SECRET=
